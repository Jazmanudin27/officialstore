{
  "expo": {
    "name": "Official Store",
    "slug": "official-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/official-store-logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/official-store-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.officialstore.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/official-store-logo.png"
      }
    },
    "web": {
      "favicon": "./assets/official-store-logo.png",
      "name": "Official Store",
      "shortName": "Official Store",
      "themeColor": "#D91E28",
      "backgroundColor": "#0F172A",
      "display": "standalone"
    }
  }
}
